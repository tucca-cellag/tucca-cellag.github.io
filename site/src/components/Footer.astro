---
/**
 * Footer: appends a TUCCA attribution band beneath Starlight's default footer.
 * The lockup links to the institutional site; the line carries the canonical
 * GitHub org + license. Keeps the org hub visually consistent with CAAIL's
 * footer treatment without its catalog-specific islands.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import TuccaLockup from './TuccaLockup.astro';
---
<div class="tucca-footer">
  <span class="tucca-foot-brand"><TuccaLockup width={150} /></span>
  <span>
    A project hub of the <a href="https://cellularagriculture.tufts.edu/">Tufts University Center for Cellular Agriculture</a>
    · Content licensed MIT · <a href="https://github.com/tucca-cellag">GitHub organization</a>
    · <a href="https://github.com/tucca-cellag" rel="noopener">Get help</a>
  </span>
</div>
<p class="tucca-foot-disclaimer">
  This site or any product or service provided by the site is not affiliated
  with or endorsed by Tufts University. Linked external resources are
  independent of TUCCA and Tufts University and remain under their own
  licenses.
</p>
<p class="tucca-foot-legal">
  <span>© 2026 Tufts University</span>
  <span>
    <a href="https://access.tufts.edu/digital-accessibility-policy">Digital Accessibility Policy</a>.
    To report an accessibility problem, email <a href="mailto:cellag@tufts.edu">cellag@tufts.edu</a>.
  </span>
  <a href="https://www.tufts.edu/about/privacy">Privacy Statement</a>
  <a href="https://oeo.tufts.edu/policies-procedures/non-discrimination-statement/">Non-Discrimination Statement</a>
</p>
<Default><slot /></Default>

<style>
  .tucca-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.8125rem; /* 13px */
    color: var(--tucca-muted);
    border-top: 1px solid var(--tucca-border);
    padding-top: 0.8rem;
    margin-top: 1rem;
  }
  .tucca-foot-brand { display: inline-flex; align-items: center; }
  .tucca-footer a { color: var(--tucca-link); }
  .tucca-foot-disclaimer {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem; /* 13px */
    line-height: 1.4;
    color: var(--tucca-muted);
  }
  /* Tufts' statements, on every page: copyright, accessibility policy and
     contact, privacy, non-discrimination. */
  .tucca-foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.5rem 0 0;
    font-size: 0.8125rem; /* 13px */
    line-height: 1.4;
    color: var(--tucca-muted);
  }
  .tucca-foot-legal a { color: var(--tucca-link); }
</style>
